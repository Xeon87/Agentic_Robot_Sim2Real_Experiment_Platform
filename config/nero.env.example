# Copy values into your shell or a private .env file; never commit API keys.
export ROS_DISTRO=humble
export AGX_ARM_WS="$HOME/agx_arm_ws"
export NERO_WS="$HOME/mujoco_ws/nero"
export VENV="$HOME/mujoco_ws/venv"
export BIO_IK_WS="$HOME/bio_ik_ws"
export TRAC_IK_WS="$HOME/trac_ik_ws"

# Any Responses-API-compatible model ID accessible to your account may be entered
# directly in the GUI. This environment variable only defines the initial value.
export NERO_LLM_MODEL="gpt-5.6-luna"

# Optional comma-separated GUI presets. API discovery can populate the list too.
export NERO_LLM_MODEL_PRESETS=""

# Optional: JSON mapping model IDs -> [input_per_M, cached_input_per_M, output_per_M]
# export NERO_LLM_PRICING_FILE="$PWD/config/pricing.json"

# Keep this secret and out of Git.
# export OPENAI_API_KEY="..."

# ---- V4.4 EMBODIED_AI removable drive (LeRobot + SmolVLA) ----
# Everything LeRobot needs (venv, HF cache, smolvla_base, datasets, checkpoints, lerobot-train runs) is stored in
# <EMBODIED_AI mount>/nero_lerobot/. The drive is found automatically by its label; override only if needed:
# export NERO_DRIVE_LABEL="EMBODIED_AI"
# export NERO_DRIVE_ROOT="/media/$USER/EMBODIED_AI"     # force a root folder
# export NERO_V44_PIP_SPEC="lerobot[smolvla]"           # e.g. pin: "lerobot[smolvla]==0.4.1"
# export NERO_V44_BASE_PYTHON="/usr/bin/python3"        # Python used to create the venv (>= 3.10)
# export NERO_V44_ALLOW_INTERNAL=1                      # allow install / training on the internal disk (not recommended)
